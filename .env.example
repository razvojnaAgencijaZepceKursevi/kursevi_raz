# Copy to .env.local and populate before running the app.

# Supabase project URL (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon/public key (Project Settings > API) — safe for browser use, respects RLS
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role key (Project Settings > API) — SERVER-ONLY, bypasses RLS.
# Never prefix with NEXT_PUBLIC_. Never import into client components.
SUPABASE_SERVICE_ROLE_KEY=

# Project ref (Project Settings > General) — used by the Supabase CLI to link the local repo
SUPABASE_PROJECT_REF=

# Database password — used by the CLI for db push/migrations against the remote project
SUPABASE_DB_PASSWORD=

# Base URL of the deployed app (auth redirects, certificate verification links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Email (Resend) — notifications
# ---------------------------------------------------------------------------
# Both are optional. With either one missing, every send is skipped and logged
# instead of throwing, and the notification settings screen says plainly that
# email is not active yet. In-app notifications are unaffected.

# API key from https://resend.com (Dashboard > API Keys). SERVER-ONLY.
RESEND_API_KEY=

# The From: header, e.g. "Kursevi <obavestenja@vas-domen.rs>". The domain must
# be verified in Resend or the provider rejects the send.
EMAIL_FROM=
