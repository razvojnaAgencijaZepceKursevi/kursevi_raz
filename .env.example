# Copy to .env.local and populate before running the app.

# Supabase project URL (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon/public key (Project Settings > API) — safe for browser use, respects RLS
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role key (Project Settings > API) — SERVER-ONLY, bypasses RLS.
# Never prefix with NEXT_PUBLIC_. Never import into client components.
SUPABASE_SERVICE_ROLE_KEY=

# Project ref (Project Settings > General) — used by the Supabase CLI to link the local repo
SUPABASE_PROJECT_REF=

# Database password — used by the CLI for db push/migrations against the remote project
SUPABASE_DB_PASSWORD=

# Base URL of the deployed app (auth redirects, certificate verification links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Email (Resend) — notifications
# ---------------------------------------------------------------------------
# Both are optional. With either one missing, every send is skipped and logged
# instead of throwing, and the notification settings screen says plainly that
# email is not active yet. In-app notifications are unaffected.

# API key from https://resend.com (Dashboard > API Keys). SERVER-ONLY.
RESEND_API_KEY=

# The From: header, e.g. "Kursevi <obavestenja@vas-domen.rs>". The domain must
# be verified in Resend or the provider rejects the send.
EMAIL_FROM=

# --- Google sign-in (optional) ------------------------------------------------
#
# Supabase performs the OAuth exchange itself, so the client id and secret are
# entered in the SUPABASE DASHBOARD (Authentication -> Providers -> Google),
# NOT read from here. These two are recorded for reference — nothing in the app
# reads them at runtime.
#
# In Google Cloud Console the authorised redirect URI must be Supabase's
# callback, not this app's:
#   https://<project-ref>.supabase.co/auth/v1/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# The switch the UI actually reads. Leave unset until the provider is enabled in
# Supabase — a visible "Continue with Google" button that 400s is worse than no
# button, because the user cannot fix it.
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false

# --- Feature flags (staged rollout) -------------------------------------------
#
# For presenting the product a segment at a time. The app is complete; these
# exist so parts of it can be revealed on a schedule.
#
# ABSENT MEANS ENABLED. Only the literal string "false" turns something off, so
# deleting every line below restores the full product. That direction is
# deliberate: defaulting to off would mean a fresh clone or a new environment
# silently ships a crippled app.
#
# They must keep the NEXT_PUBLIC_ prefix — Next only exposes those to the
# browser, and most of this app's screens are Client Components.
#
# A flag hides a feature's nav entries and 404s its routes. It is NOT access
# control: the API routes and RLS policies are untouched.
NEXT_PUBLIC_FEATURE_CATALOG=true          # public course catalogue + course pages
NEXT_PUBLIC_FEATURE_PURCHASES=true        # access requests, admin queue, payment details
NEXT_PUBLIC_FEATURE_QUIZZES=true          # quizzes on a module
NEXT_PUBLIC_FEATURE_TASKS=true            # task submissions + review threads
NEXT_PUBLIC_FEATURE_CERTIFICATES=true     # issuing, certificate page, PDF, delivery
NEXT_PUBLIC_FEATURE_NOTIFICATIONS=true    # in-app bell, list, per-event settings, email
NEXT_PUBLIC_FEATURE_SUPPORT=true          # /issues and the admin support queue
NEXT_PUBLIC_FEATURE_BLOG=true             # blog index and posts
NEXT_PUBLIC_FEATURE_NEWSLETTER=true       # opt-in, admin composer and export
NEXT_PUBLIC_FEATURE_TEACHERS=true         # teacher role and course ownership UI
NEXT_PUBLIC_FEATURE_THEME_SWITCH=true     # light/dark toggle and its settings tab
